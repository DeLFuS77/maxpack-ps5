# cmake -DIN=<file> -DOUT=<output.c> -DNAME=<symbol> -P embed.cmake
# Writes a .c with the contents of IN as a byte array (NUL-terminated) and its length.
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" hexlen)
math(EXPR len "${hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUT}"
  "// Generated by cmake/embed.cmake from ${IN}. Do not edit.\n"
  "#include <stddef.h>\n"
  "const unsigned char ${NAME}[] = {${bytes}0x00};\n"
  "const size_t ${NAME}_len = ${len};\n")
